{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build with OpenCV",
            "type": "shell",
            "command": "g++",
            "args": [
                "hani_screen_shot/main.cpp",
                "hani_screen_shot/screen_shot.cpp",
                "hani_screen_shot/video-generator.cpp",
                "-ID:/msys64/mingw64/include",
                "-ID:/msys64/mingw64/include/opencv4",
                "-LD:/msys64/mingw64/lib",
                "-lopencv_core",
                "-lopencv_imgproc",
                "-lopencv_imgcodecs",
                "-lopencv_highgui",
                "-o",
                "generator.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
